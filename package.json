{
  "name": "next-indexnow",
  "version": "1.0.1",
  "description": "IndexNow protocol integration for Next.js applications",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.mts",
        "default": "./dist/next.mjs"
      },
      "require": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      }
    }
  },
  "bin": {
    "next-indexnow": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "format": "prettier --write \"{src,test}/**/*.ts\" \"*.{ts,mjs,json,md}\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\" \"*.{ts,mjs,json,md}\" \".github/workflows/*.yml\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nextjs",
    "indexnow",
    "seo",
    "bing",
    "yandex"
  ],
  "author": "Prime Sentia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/primesentia/next-indexnow.git"
  },
  "bugs": {
    "url": "https://github.com/primesentia/next-indexnow/issues"
  },
  "homepage": "https://github.com/primesentia/next-indexnow#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "next": "^16.0.0",
    "prettier": "^3.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.60.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "next": ">=13.0.0"
  }
}
